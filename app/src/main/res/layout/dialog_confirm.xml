<?xml version="1.0" encoding="utf-8"?>
<com.aries.ui.view.radius.RadiusLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/dp_60"
    android:paddingTop="@dimen/dp_28"
    android:paddingEnd="@dimen/dp_60"
    android:paddingBottom="@dimen/dp_28"
    app:rv_backgroundColor="@color/white"
    app:rv_radius="@dimen/dp_7"
    tools:ignore="MissingDefaultResource">

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:gravity="center"
        android:textColor="@color/black"
        android:textSize="@dimen/sp_18"
        android:textStyle="bold"
        tools:text="@string/温馨提示" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/dp_20"
        android:orientation="horizontal">

        <com.aries.ui.view.radius.RadiusTextView
            android:id="@+id/rtv_left"
            android:layout_width="@dimen/dp_78"
            android:layout_height="@dimen/dp_37"
            android:layout_marginEnd="@dimen/dp_10"
            android:gravity="center"
            android:text="@string/取消"
            android:textColor="@color/black"
            android:textSize="@dimen/sp_15"
            app:rv_backgroundColor="@color/white"
            app:rv_radius="@dimen/dp_7"
            app:rv_strokeColor="@color/color_ff999999"
            app:rv_strokeWidth="@dimen/dp_1" />

        <com.aries.ui.view.radius.RadiusTextView
            android:id="@+id/rtv_right"
            android:layout_width="@dimen/dp_78"
            android:layout_height="@dimen/dp_37"
            android:layout_marginStart="@dimen/dp_10"
            android:gravity="center"
            android:text="@string/确认"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_15"
            app:rv_backgroundColor="@color/color_ff0371f4"
            app:rv_radius="@dimen/dp_7" />
    </LinearLayout>
</com.aries.ui.view.radius.RadiusLinearLayout>