<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_ffe8eef6">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="fitXY"
        android:src="@mipmap/ic_login_top_bg" />

    <ImageView
        android:id="@+id/iv_logo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="@dimen/dp_67"
        android:src="@mipmap/ic_xun_logo" />

    <com.aries.ui.view.radius.RadiusRelativeLayout
        android:id="@+id/rfl_street"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_60"
        android:layout_below="@+id/iv_logo"
        android:layout_marginStart="@dimen/dp_15"
        android:layout_marginTop="@dimen/dp_60"
        android:layout_marginEnd="@dimen/dp_15"
        android:paddingEnd="@dimen/dp_13"
        app:rv_backgroundColor="@color/white"
        app:rv_radius="@dimen/dp_7"
        app:rv_strokeColor="@color/color_ff0371f4"
        app:rv_strokeWidth="@dimen/dp_1">

        <ImageView
            android:id="@+id/iv_parking"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/dp_15"
            android:layout_marginEnd="@dimen/dp_15"
            android:src="@mipmap/ic_p" />

        <TextView
            android:id="@+id/tv_street"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/dp_40"
            android:layout_toStartOf="@+id/cb_street"
            android:layout_toEndOf="@+id/iv_parking"
            android:ellipsize="end"
            android:hint="@string/请选择工作路段"
            android:maxLines="1"
            android:textColor="@color/color_ff1a1a1a"
            android:textSize="@dimen/sp_19"
            tools:text="定西路(愚园路～安化路)西侧" />

        <CheckBox
            android:id="@+id/cb_street"
            android:layout_width="@dimen/dp_22"
            android:layout_height="@dimen/dp_22"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@color/transparent"
            android:button="@drawable/selector_lot_arrow"
            android:checked="false" />
    </com.aries.ui.view.radius.RadiusRelativeLayout>

    <com.aries.ui.view.radius.RadiusLinearLayout
        android:id="@+id/rll_account"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_60"
        android:layout_below="@+id/rfl_street"
        android:layout_marginStart="@dimen/dp_13"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginEnd="@dimen/dp_13"
        android:padding="@dimen/dp_17"
        app:rv_radius="@dimen/dp_7"
        app:rv_strokeColor="@color/color_ff0371f4"
        app:rv_strokeWidth="@dimen/dp_1">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/ic_login_account_logo" />

        <EditText
            android:id="@+id/et_account"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/dp_14"
            android:background="@null"
            android:gravity="center_vertical"
            android:hint="@string/请输入账号"
            android:imeOptions="actionGo"
            android:textColor="@color/black"
            android:textColorHint="@color/color_ff6c737b"
            android:textCursorDrawable="@drawable/shape_cursor"
            android:textSize="@dimen/sp_19"
            tools:text="34351302" />
    </com.aries.ui.view.radius.RadiusLinearLayout>

    <com.aries.ui.view.radius.RadiusLinearLayout
        android:id="@+id/rll_pw"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_60"
        android:layout_below="@+id/rll_account"
        android:layout_marginStart="@dimen/dp_13"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginEnd="@dimen/dp_13"
        android:padding="@dimen/dp_17"
        app:rv_radius="@dimen/dp_7"
        app:rv_strokeColor="@color/color_ff0371f4"
        app:rv_strokeWidth="@dimen/dp_1">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/ic_login_pw_logo" />

        <EditText
            android:id="@+id/et_pw"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/dp_14"
            android:background="@null"
            android:gravity="center_vertical"
            android:hint="@string/请输入密码"
            android:inputType="textPassword"
            android:textColor="@color/black"
            android:textColorHint="@color/color_ff6c737b"
            android:textCursorDrawable="@drawable/shape_cursor"
            android:textSize="@dimen/sp_19"
            tools:text="qwe12345" />
    </com.aries.ui.view.radius.RadiusLinearLayout>

    <TextView
        android:id="@+id/tv_forgetPw"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/rll_pw"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="@dimen/dp_45"
        android:layout_marginEnd="@dimen/dp_26"
        android:text="@string/忘记密码"
        android:textColor="@color/color_ff0371f4"
        android:textSize="@dimen/sp_19"
        android:visibility="invisible" />

    <com.aries.ui.view.radius.RadiusTextView
        android:id="@+id/rtv_login"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/tv_forgetPw"
        android:layout_marginStart="@dimen/dp_13"
        android:layout_marginTop="@dimen/dp_20"
        android:layout_marginEnd="@dimen/dp_13"
        android:gravity="center"
        android:paddingTop="@dimen/dp_20"
        android:paddingBottom="@dimen/dp_20"
        android:text="@string/签到"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_20"
        android:textStyle="bold"
        app:rv_backgroundColor="@color/color_990371f4"
        app:rv_radius="@dimen/dp_7" />

    <TextView
        android:id="@+id/tv_version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="20dp"
        android:textColor="@color/color_ff1a1a1a"
        tools:text="v1.1.1" />
</RelativeLayout>