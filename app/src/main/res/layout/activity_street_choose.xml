<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_ffe8eef6"
    android:orientation="vertical">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="fitXY"
        android:src="@mipmap/ic_light_top_bg" />

    <include
        android:id="@+id/layout_toolbar"
        layout="@layout/layout_comment_toolbar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/layout_toolbar"
        android:background="@color/transparent"
        android:orientation="vertical">

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tl_street"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_40"
            android:layout_gravity="center_horizontal"
            android:layout_margin="@dimen/dp_10"
            app:tabIndicatorFullWidth="false"
            app:tabIndicatorHeight="@dimen/dp_0"
            app:tabPaddingBottom="0.1dp"
            app:tabPaddingEnd="-0.1dp"
            app:tabPaddingStart="0.1dp"
            app:tabPaddingTop="0.1dp"
            app:tabSelectedTextColor="@color/white"
            app:tabTextColor="@color/color_ff0371f4" />

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/vp_street"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/transparent" />
    </LinearLayout>

</RelativeLayout>