<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fl_order"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/transparent"
    android:paddingBottom="@dimen/dp_13">

    <com.aries.ui.view.radius.RadiusLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/dp_13"
        android:paddingTop="@dimen/dp_17"
        android:paddingEnd="@dimen/dp_13"
        android:paddingBottom="@dimen/dp_22"
        app:rv_backgroundColor="@color/white"
        app:rv_radius="@dimen/dp_7">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tv_num"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/color_ff999999"
                android:textSize="@dimen/sp_20"
                android:textStyle="bold"
                tools:text="01" />

            <TextView
                android:id="@+id/tv_monthPayId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_15"
                android:textColor="@color/color_ff1a1a1a"
                android:textSize="@dimen/sp_20"
                android:textStyle="bold"
                tools:text="20211203HPZ05201027812" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_month"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/color_ff1a1a1a"
            android:layout_marginTop="@dimen/dp_5"
            android:textSize="@dimen/sp_20"
            tools:text="月结月份:12月" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_street"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10"
            android:drawableStart="@mipmap/ic_no"
            android:drawablePadding="@dimen/dp_10"
            android:textColor="@color/color_ff1a1a1a"
            android:textSize="@dimen/sp_19"
            tools:text="CN-007-025" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_5">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_oweAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="@dimen/dp_10"
                android:drawableStart="@mipmap/ic_fee"
                android:textColor="@color/color_ffe92404"
                android:textSize="@dimen/sp_19"
                tools:text="欠费:15.00元" />
        </FrameLayout>

    </com.aries.ui.view.radius.RadiusLinearLayout>
</FrameLayout>