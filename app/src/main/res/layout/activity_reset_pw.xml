<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_ffe8eef6"
    android:orientation="vertical">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="fitXY"
        android:src="@mipmap/ic_light_top_bg" />

    <include
        android:id="@+id/layout_toolbar"
        layout="@layout/layout_comment_toolbar" />

    <LinearLayout
        android:id="@+id/ll_account"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/layout_toolbar"
        android:layout_marginStart="@dimen/dp_13"
        android:layout_marginTop="@dimen/dp_40"
        android:layout_marginEnd="@dimen/dp_13"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_resetPw"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/重置密码"
            android:textColor="@color/color_ff1a1a1a"
            android:textSize="@dimen/sp_24"
            android:textStyle="bold" />

        <com.aries.ui.view.radius.RadiusLinearLayout
            android:id="@+id/rll_account"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_60"
            android:layout_marginTop="@dimen/dp_40"
            android:paddingStart="@dimen/dp_17"
            android:paddingEnd="@dimen/dp_17"
            app:rv_radius="@dimen/dp_7"
            app:rv_strokeColor="@color/color_ff0371f4"
            app:rv_strokeWidth="@dimen/dp_1">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:src="@mipmap/ic_login_pw_logo" />

            <EditText
                android:id="@+id/et_account"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/dp_14"
                android:background="@null"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center_vertical"
                android:hint="@string/请输入账号"
                android:imeOptions="actionNone"
                android:inputType="text"
                android:textColor="@color/black"
                android:textColorHint="@color/color_ff99a7a6"
                android:textCursorDrawable="@drawable/shape_cursor"
                android:textSize="@dimen/sp_19" />
        </com.aries.ui.view.radius.RadiusLinearLayout>
    </LinearLayout>

    <com.aries.ui.view.radius.RadiusLinearLayout
        android:id="@+id/rll_oldPw"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_60"
        android:layout_below="@+id/ll_account"
        android:layout_marginStart="@dimen/dp_13"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginEnd="@dimen/dp_13"
        android:paddingStart="@dimen/dp_17"
        android:paddingEnd="@dimen/dp_17"
        app:rv_radius="@dimen/dp_7"
        app:rv_strokeColor="@color/color_ff0371f4"
        app:rv_strokeWidth="@dimen/dp_1">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:src="@mipmap/ic_login_pw_logo" />

        <EditText
            android:id="@+id/et_oldPw"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/dp_14"
            android:background="@null"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center_vertical"
            android:hint="@string/请输入旧密码"
            android:imeOptions="flagNoExtractUi"
            android:inputType="textPassword"
            android:textColor="@color/black"
            android:textColorHint="@color/color_ff99a7a6"
            android:textCursorDrawable="@drawable/shape_cursor"
            android:textSize="@dimen/sp_19" />
    </com.aries.ui.view.radius.RadiusLinearLayout>

    <com.aries.ui.view.radius.RadiusLinearLayout
        android:id="@+id/rll_newPw"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_60"
        android:layout_below="@+id/rll_oldPw"
        android:layout_marginStart="@dimen/dp_13"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginEnd="@dimen/dp_13"
        android:paddingStart="@dimen/dp_17"
        android:paddingEnd="@dimen/dp_17"
        app:rv_radius="@dimen/dp_7"
        app:rv_strokeColor="@color/color_ff0371f4"
        app:rv_strokeWidth="@dimen/dp_1">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:src="@mipmap/ic_login_pw_logo" />

        <EditText
            android:id="@+id/et_newPw"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/dp_14"
            android:background="@null"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center_vertical"
            android:hint="@string/请输入新密码"
            android:imeOptions="flagNoExtractUi"
            android:inputType="textPassword"
            android:textColor="@color/black"
            android:textColorHint="@color/color_ff99a7a6"
            android:textCursorDrawable="@drawable/shape_cursor"
            android:textSize="@dimen/sp_19" />
    </com.aries.ui.view.radius.RadiusLinearLayout>

    <com.aries.ui.view.radius.RadiusLinearLayout
        android:id="@+id/rll_repeatPw"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_60"
        android:layout_below="@+id/rll_newPw"
        android:layout_marginStart="@dimen/dp_13"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginEnd="@dimen/dp_13"
        android:paddingStart="@dimen/dp_17"
        android:paddingEnd="@dimen/dp_17"
        app:rv_radius="@dimen/dp_7"
        app:rv_strokeColor="@color/color_ff0371f4"
        app:rv_strokeWidth="@dimen/dp_1">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:src="@mipmap/ic_login_pw_logo" />

        <EditText
            android:id="@+id/et_repeatPw"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/dp_14"
            android:background="@null"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center_vertical"
            android:hint="@string/重复密码"
            android:imeOptions="flagNoExtractUi"
            android:inputType="textPassword"
            android:textColor="@color/black"
            android:textColorHint="@color/color_ff99a7a6"
            android:textCursorDrawable="@drawable/shape_cursor"
            android:textSize="@dimen/sp_19" />
    </com.aries.ui.view.radius.RadiusLinearLayout>

    <com.aries.ui.view.radius.RadiusTextView
        android:id="@+id/rtv_reset"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/rll_repeatPw"
        android:layout_marginStart="@dimen/dp_13"
        android:layout_marginTop="@dimen/dp_68"
        android:layout_marginEnd="@dimen/dp_13"
        android:gravity="center"
        android:paddingTop="@dimen/dp_20"
        android:paddingBottom="@dimen/dp_20"
        android:text="@string/确定"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_20"
        android:textStyle="bold"
        app:rv_backgroundColor="@color/color_990371f4"
        app:rv_radius="@dimen/dp_7" />
</RelativeLayout>